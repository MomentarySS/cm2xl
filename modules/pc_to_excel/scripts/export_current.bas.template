' export_current.bas — PCDMIS 内按需导出（CSV，不依赖 Excel）
Option Explicit

Const CONFIG_PATH = "@@CONFIG_PATH@@"
Const DATA_TYPE_DIMENSION = "D"
Const DATA_TYPE_FCF = "F"
Const DATA_TYPE_FCFDIM = "FD"

Const ID = 2
Const AXIS = 132
Const NOMINAL = 166
Const F_PLUS_TOL = 167
Const F_MINUS_TOL = 168
Const DIM_MEASURED = 328
Const DIM_LENGTH = 173
Const DIM_BONUS = 324
Const UNIT_TYPE = 49
Const LINE1_FEATNAME = 645
Const LINE1_NOMINAL = 646
Const LINE1_MEAS = 647
Const LINE1_PLUSTOL = 648
Const LINE1_MINUSTOL = 649
Const LINE1_BONUS = 782

Sub Main
    On Error GoTo FatalError
    Dim part As Object
    Dim pcdmisVersion As String
    If Not connect(part, pcdmisVersion) Then
        MsgBox "无法连接 PC-DMIS 活动程序。", 16, "导出失败"
        Exit Sub
    End If

    Dim outPath As String
    Dim markedOnly As Boolean
    If Not readExportConfig(outPath, markedOnly) Then
        outPath = "C:\Temp\pcdmis_partial_export.csv"
        markedOnly = False
    End If

    Dim rows() As String
    Dim rowCount As Long
    rowCount = 0
    ReDim Preserve rows(0 To rowCount)
    rows(rowCount) = "ID,类型,理论值,上公差,下公差,实测值,Bonus,备注"

    Dim cmds As Object
    Set cmds = part.Commands
    Dim i As Long
    Dim cmd As Object
    Dim fields(0 To 7) As String
    Dim versionYear As Long
    versionYear = getPcdmisYear(pcdmisVersion)

    For i = 1 To cmds.Count
        On Error Resume Next
        Set cmd = cmds(i)
        If Err.Number <> 0 Then
            Err.Clear
            GoTo ContinueLoop
        End If
        On Error GoTo FatalError

        If markedOnly Then
            On Error Resume Next
            If cmd.Marked = False Then GoTo ContinueLoop
            On Error GoTo FatalError
        End If

        If readDimension(cmd, fields) Then
            rowCount = rowCount + 1
            ReDim Preserve rows(0 To rowCount)
            rows(rowCount) = joinCsvRow(fields)
        End If

        If versionYear >= 2022 Then
            readFcf cmd, fields, rows, rowCount
        ElseIf versionYear > 0 Then
            readFcfOld cmd, fields, rows, rowCount
        End If
ContinueLoop:
    Next i

    If rowCount < 1 Then
        MsgBox "未找到可导出的测量数据。" & vbCrLf & vbCrLf & _
            "请检查：" & vbCrLf & _
            "1. 尺寸命令是否已 Mark" & vbCrLf & _
            "2. 是否已有实测值" & vbCrLf & _
            "3. export_config.txt 第2行 YES=仅Mark / NO=全部尺寸", 48, "导出"
        Exit Sub
    End If

    If Not saveCsv(outPath, rows) Then
        MsgBox "写入文件失败: " & outPath & vbCrLf & Err.Description, 16, "导出失败"
    Else
        MsgBox "已导出 " & CStr(rowCount) & " 条到:" & vbCrLf & outPath & vbCrLf & vbCrLf & _
            "可用 Excel 直接打开 CSV。", 64, "导出完成"
    End If

    Set cmds = Nothing
    Set part = Nothing
    Exit Sub

FatalError:
    MsgBox "脚本运行错误: " & Err.Description & " (" & Err.Number & ")", 16, "导出失败"
End Sub

Function readExportConfig(ByRef outPath As String, ByRef markedOnly As Boolean) As Boolean
    readExportConfig = False
    markedOnly = False
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FileExists(CONFIG_PATH) Then Exit Function
    Dim ts As Object
    Set ts = fso.OpenTextFile(CONFIG_PATH, 1, False, -1)
    outPath = Trim(ts.ReadLine)
    Dim flag As String
    If Not ts.AtEndOfStream Then flag = UCase(Trim(ts.ReadLine))
    ts.Close
    markedOnly = (flag = "YES" Or flag = "Y" Or flag = "1")
    readExportConfig = (Len(outPath) > 0)
End Function

Function connect(ByRef part As Object, ByRef pcdmisVersion As String) As Boolean
    connect = False
    Set part = Nothing
    Dim app As Object
    Set app = CreateObject("PCDLRN.Application")
    pcdmisVersion = app.VersionString
    Set part = app.ActivePartProgram
    connect = Not part Is Nothing
    Set app = Nothing
End Function

Function getPcdmisYear(ByVal versionStr As String) As Long
    getPcdmisYear = -1
    If Len(Trim(versionStr)) < 4 Then Exit Function
    Dim y As String
    y = Left(Trim(versionStr), 4)
    If IsNumeric(y) Then getPcdmisYear = CLng(y)
End Function

Function readDimension(ByRef cmd As Object, ByRef fields() As String) As Boolean
    readDimension = False
    If Not cmd.IsDimension Then Exit Function

    Dim idVal As String
    idVal = CStr(cmd.ID)
    If idVal = "" Then idVal = CStr(cmd.GetText(ID, 0))

    Dim nominal As Variant, plusTol As Variant, minusTol As Variant
    Dim measured As Variant, bonus As Variant, axisVal As Variant
    Dim ok As Boolean

    On Error Resume Next
    Dim dimObj As Object
    Set dimObj = cmd.DimensionCommand
    If Err.Number = 0 And Not dimObj Is Nothing Then
        fields(0) = CStr(dimObj.ID)
        If fields(0) = "" Then fields(0) = idVal
        fields(1) = DATA_TYPE_DIMENSION
        fields(2) = CStr(dimObj.NOMINAL)
        fields(3) = CStr(dimObj.Plus)
        fields(4) = CStr(dimObj.Minus)
        fields(5) = CStr(dimObj.Measured)
        fields(6) = CStr(dimObj.Bonus)
        fields(7) = CStr(dimObj.AxisLetter)
        ok = (fields(5) <> "" And fields(5) <> "False")
        readDimension = ok
        Exit Function
    End If
    Err.Clear
    On Error GoTo 0

    fields(0) = idVal
    fields(1) = DATA_TYPE_DIMENSION
    nominal = cmd.GetFieldValue(NOMINAL, 0)
    plusTol = cmd.GetFieldValue(F_PLUS_TOL, 0)
    minusTol = cmd.GetFieldValue(F_MINUS_TOL, 0)
    measured = cmd.GetFieldValue(DIM_MEASURED, 0)
    If measured = False Or measured = "" Then measured = cmd.GetFieldValue(DIM_LENGTH, 0)
    bonus = cmd.GetFieldValue(DIM_BONUS, 0)
    axisVal = cmd.GetFieldValue(AXIS, 0)
    If axisVal = False Or axisVal = "" Then axisVal = cmd.GetText(AXIS, 0)

    If measured = False Or measured = "" Then Exit Function

    fields(2) = CStr(nominal)
    fields(3) = CStr(plusTol)
    fields(4) = CStr(minusTol)
    fields(5) = CStr(measured)
    fields(6) = CStr(bonus)
    fields(7) = CStr(axisVal)
    readDimension = True
End Function

Sub readFcfOld(ByRef cmd As Object, ByRef fields() As String, ByRef rows() As String, ByRef rowCount As Long)
    If Not cmd.IsFcfCommand Then Exit Sub
    Dim idid As String
    idid = cmd.ID
    Dim i As Long, total As Long
    total = cmd.GetDataTypeCount(LINE1_MEAS)
    For i = 1 To total
        fields(0) = idid
        fields(1) = DATA_TYPE_FCFDIM
        fields(2) = cmd.GetFieldValue(LINE1_NOMINAL, i)
        fields(3) = cmd.GetFieldValue(LINE1_PLUSTOL, i)
        fields(4) = cmd.GetFieldValue(LINE1_MINUSTOL, i)
        fields(5) = cmd.GetFieldValue(LINE1_MEAS, i)
        fields(6) = cmd.GetFieldValue(LINE1_BONUS, i)
        fields(7) = cmd.GetFieldValue(LINE1_FEATNAME, i)
        If fields(5) <> False And fields(5) <> "" Then
            rowCount = rowCount + 1
            ReDim Preserve rows(0 To rowCount)
            rows(rowCount) = joinCsvRow(fields)
        End If
    Next i
End Sub

Sub readFcf(ByRef cmd As Object, ByRef fields() As String, ByRef rows() As String, ByRef rowCount As Long)
    If Not cmd.IsToleranceCommand Then Exit Sub
    Dim tolCmd As Object
    Set tolCmd = cmd.ToleranceCommand
    Dim idid As String
    idid = tolCmd.ID
    Dim j As Long, k As Long
    For j = 1 To tolCmd.sizeCountCombined
        fields(0) = idid
        fields(1) = DATA_TYPE_FCFDIM
        fields(2) = tolCmd.SizeNominal(j)
        fields(3) = tolCmd.SizePlusTol(j)
        fields(4) = tolCmd.SizeMinusTol(j)
        fields(5) = tolCmd.SizeMeasured(j)
        fields(6) = "0"
        fields(7) = tolCmd.SizeText(j)
        If fields(5) <> "" Then
            rowCount = rowCount + 1
            ReDim Preserve rows(0 To rowCount)
            rows(rowCount) = joinCsvRow(fields)
        End If
    Next j
    For k = 1 To tolCmd.SegmentCount
        For j = 1 To tolCmd.FeatureCount
            fields(0) = idid
            fields(1) = DATA_TYPE_FCF
            fields(2) = "0"
            fields(3) = tolCmd.SegmentDimPlusTol(k, j)
            fields(4) = "0"
            fields(5) = tolCmd.SegmentDimMeasured(k, j)
            fields(6) = tolCmd.SegmentDimBonus(k, j)
            fields(7) = tolCmd.FeatureID(j)
            If fields(5) <> "" Then
                rowCount = rowCount + 1
                ReDim Preserve rows(0 To rowCount)
                rows(rowCount) = joinCsvRow(fields)
            End If
        Next j
    Next k
End Sub

Function joinCsvRow(ByRef fields() As String) As String
    Dim i As Long, s As String
    s = ""
    For i = LBound(fields) To UBound(fields)
        If i > LBound(fields) Then s = s & ","
        s = s & """" & Replace(CStr(fields(i)), """", """""") & """"
    Next i
    joinCsvRow = s
End Function

Function saveCsv(ByVal filePath As String, ByRef rows() As String) As Boolean
    On Error GoTo ErrorHandler
    saveCsv = False
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim parentFolder As String
    parentFolder = fso.GetParentFolderName(filePath)
    If parentFolder <> "" And Not fso.FolderExists(parentFolder) Then
        Dim wsh As Object
        Set wsh = CreateObject("WScript.Shell")
        wsh.Run "cmd.exe /c mkdir """ & parentFolder & """", 0, True
    End If

    Dim stream As Object
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    Dim i As Long
    For i = LBound(rows) To UBound(rows)
        stream.WriteText rows(i) & vbCrLf
    Next i
    stream.SaveToFile filePath, 2
    stream.Close
    saveCsv = True
    Exit Function
ErrorHandler:
    saveCsv = False
End Function
